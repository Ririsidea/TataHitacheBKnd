PORT=8001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/tata-h-map-shopify

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-10
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
# Shopify Admin API credential (backend -> Shopify only). The custom app needs these Admin API
# scopes, incl. write_order_edits for PUT /api/map/orders/:id (reinstall/approve after adding it):
#   read_products, read_inventory, write_orders, read_orders, write_draft_orders, write_order_edits
#   (+ read_all_orders to edit orders older than 60 days)
SHOPIFY_ACCESS_TOKEN=your-shopify-admin-access-token
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-signing-secret

MAP_CALLBACK_URL=http://localhost:5000/api/map/callback
# Key sent as the `x-api-key` header to every Shopify-related route (stock, product, orders,
# create/cancel/update) by the third-party MAP system AND by the web app - so the same value
# is also set as MAP_API_KEY in the frontend .env and ends up in the frontend bundle.
# Must be its own random value - never a Shopify credential.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAP_API_KEY=your-map-api-key

SAP_EXPORT_MODE=local
SAP_EXPORT_LOCAL_DIR=./exports

# Signs employee login tokens for the web app - unrelated to MAP_API_KEY
JWT_SECRET=change-this-to-a-long-random-secret

# Only this email gets the admin add/delete-employee endpoints (/api/admin/*).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin Name
