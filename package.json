    "backfill:order-details": "tsx src/scripts/backfillOrderDetails.ts",
    "export:daily": "tsx src/scripts/runDailyExport.ts",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
